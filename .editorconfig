root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf

[*.command]
end_of_line = lf

[windows/scripts/{common-windows,start-aurora-skin}.ps1]
charset = utf-8-bom
